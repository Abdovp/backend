# EasyPanel: backend must be in the SAME project as PostgreSQL for internal URLs.
#
# Recommended — everything in project "boya-shop":
#   database service name: database  →  host boya-shop_database
#   Copy Internal Connection URL from boya-shop → database → Credentials
#
# DATABASE_URL=postgres://postgres:YOUR_PASSWORD@boya-shop_database:5432/boya-shop?sslmode=disable
#
# If database stays in a separate project "boya" (not recommended):
#   Expose PostgreSQL on a public port in project boya, then use server IP + that port as host.
#   Internal host boya_database does NOT work from boya-shop backend.
#
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@boya-shop_database:5432/boya-shop?sslmode=disable
GOOGLE_SHEET_WEBHOOK_URL=
FACEBOOK_CAPI_TOKEN=
TIKTOK_CAPI_TOKEN=
SNAPCHAT_CAPI_TOKEN=
FACEBOOK_PIXEL_ID=
TIKTOK_PIXEL_ID=
SNAPCHAT_PIXEL_ID=
SECRET_KEY=
DOMAIN=api.boya-shop.online
