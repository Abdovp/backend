APP_ENV=production
APP_NAME=Boya Shop API
API_BASE_URL=https://api.boyashop.store
FRONTEND_URL=https://boyashop.store

# Production (Easypanel) — use YOUR service names from the panel:
DATABASE_URL=postgres://boyashop:YOUR_PASSWORD@boyashop_database:5432/boyashop?sslmode=disable
# Do NOT use boya-shop_database — that hostname is local Docker only.

CORS_ORIGINS=https://boyashop.store,https://www.boyashop.store,http://localhost:3000,http://127.0.0.1:3000

# Google Sheets webhook (Apps Script deployment URL)
# 1) Paste backend/scripts/google-apps-script.gs into Google Apps Script
# 2) Deploy as Web app (Anyone) and paste the URL here:
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

META_PIXEL_ID=
META_ACCESS_TOKEN=
META_API_VERSION=v20.0

TIKTOK_PIXEL_CODE=
TIKTOK_ACCESS_TOKEN=
TIKTOK_API_VERSION=v1.3

SNAP_PIXEL_ID=
SNAP_ACCESS_TOKEN=

ENABLE_CAPI=true
ENABLE_META_CAPI=true
ENABLE_TIKTOK_CAPI=true
ENABLE_SNAP_CAPI=true

# Admin dashboard login (required for /api/admin/*)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret-key
ADMIN_JWT_EXPIRE_HOURS=24
