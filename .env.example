# ── PostgreSQL (EasyPanel) ──
# Project: boya-shop → service: database → Credentials → Internal Connection URL
# Host must be boya-shop_database (same project as backend). DB name is usually boya-shop.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@boya-shop_database:5432/boya-shop?sslmode=disable

# ── API domain ──
DOMAIN=api.boya-shop.online

# ── Google Sheets webhook (optional — order + order_items payload) ──
GOOGLE_SHEET_WEBHOOK_URL=

# ── Server-side CAPI (Purchase deduped with web pixels via event_id) ──
# Pixel IDs must match NEXT_PUBLIC_* IDs on the frontend service.
FACEBOOK_PIXEL_ID=
FACEBOOK_CAPI_TOKEN=
TIKTOK_PIXEL_ID=
TIKTOK_CAPI_TOKEN=
SNAPCHAT_PIXEL_ID=
SNAPCHAT_CAPI_TOKEN=

# ── App secret (optional, for future signed endpoints) ──
SECRET_KEY=
